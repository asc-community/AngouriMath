
<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ output extension=".cs" #>
<#
    // The one-argument functions, in the order they are defined below. Both the definitions and
    // the dispatch table at the bottom are generated from these, so a function cannot be added
    // to one and forgotten in the other.
    var unary = new[]{ "Sin", "Cos", "Tan", "Asin", "Acos", "Atan",
                       "Cot", "Sec", "Csc", "Acot", "Asec", "Acsc",
                       "Abs", "Sgn" };
    var binary = new[]{ "Log", "Pow" };
    var types = new[]{ "System.Numerics.Complex", "double", "float", "long", "int", "BigInteger" };
#>
