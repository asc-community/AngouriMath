#!csharp

// The LaTeX formatters, registered by reflection rather than against AngouriMath's types: an F# notebook loads
// this script into the C# kernel, which has no reference to AngouriMath, and `using AngouriMath;` there was a
// compile error at the top of every F# notebook. https://github.com/asc-community/AngouriMath/issues/2109
using System;
using System.Linq;
using Microsoft.DotNet.Interactive.Formatting;

static Type FindType(string assembly, string name)
    => AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault(a => a.GetName().Name == assembly)?.GetType(name);

static void RegisterLatex(Type type, Func<object, string> latexer)
{
    Formatter.Register(type, (o, writer) => writer.Write($"$${latexer(o)}$$"), "text/latex");
    Formatter.Register(type, (o, writer) => writer.Write($@"
<script id='MathJax-script' async src='https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js'></script>
\[{latexer(o)}\]"), "text/html");
    Formatter.SetPreferredMimeTypesFor(type, "text/latex");
}

foreach (var name in new[] { "PeterO.Numbers.EDecimal", "PeterO.Numbers.EInteger" })
    if (FindType("Numbers", name) is { } plain)
    {
        Formatter.SetPreferredMimeTypesFor(plain, "text/plain");
        Formatter.Register(plain, (o, writer) => writer.Write(o.ToString()), "text/plain");
    }

if (FindType("AngouriMath", "AngouriMath.Core.ILatexizeable") is { } latexizeable
    && latexizeable.GetMethod("Latexize", Type.EmptyTypes) is { } latexize)
    RegisterLatex(latexizeable, o => (string)latexize.Invoke(o, null));

if (FindType("Numbers", "PeterO.Numbers.ERational") is { } rational)
    RegisterLatex(rational, o => $@"\frac{{{rational.GetProperty("Numerator").GetValue(o)}}}{{{rational.GetProperty("Denominator").GetValue(o)}}}");

"Extensions for LaTeX loaded!"
